#!/usr/bin/env python3
"""Launch CLIVE with its isolated dependencies when installed."""
import os
import sys
from pathlib import Path

source = Path(__file__).resolve().parent.parent
installed = Path.home() / ".local/share/desktop-forge"
environment = installed / "clive-venv/bin/python"
if not environment.exists():
    environment = source / ".venv/bin/python"
if environment.exists() and Path(sys.prefix).resolve() != environment.parent.parent.resolve():
    os.execv(str(environment), [str(environment), str(Path(__file__).resolve()), *sys.argv[1:]])
sys.path.insert(0, str(source if (source / "desktop_forge").exists() else installed))
from desktop_forge.clive.service import main
raise SystemExit(main())
