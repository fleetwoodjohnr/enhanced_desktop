{"nodes": [{"id": "readme_desktop_forge", "label": "Desktop Forge", "file_type": "concept", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_clive_assistant", "label": "CLIVE Assistant", "file_type": "concept", "source_file": "README.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_app_access", "label": "App Access", "file_type": "rationale", "source_file": "README.md", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforced where tools run, not in the interface: every action is checked against the switches at the moment it runs, so turning an app off stops the very next action even mid-task. The app switch overrides its capability switches. Defaults preserve what CLIVE could already do; apps installed later start off."}, {"id": "readme_side_door_closure", "label": "Side Door Closure", "file_type": "rationale", "source_file": "README.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Switching off a service also blocks alternate routes to it (Thunderbird/Evolution/mail.google.com for Gmail, GNOME Calendar for Calendar, notes folder for file tools and Terminal) and redacts previously read results from model context."}, {"id": "readme_app_permissions", "label": "App Permissions (Ask Before)", "file_type": "rationale", "source_file": "README.md", "source_location": "L114", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High-risk actions (send email, delete, cancel events, push, install, admin) show exactly what will happen and wait for Confirm even under Auto-approve everything; administrator commands can never be set to not ask."}, {"id": "readme_ollama", "label": "Ollama", "file_type": "concept", "source_file": "README.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ollama_cloud", "label": "Ollama Cloud", "file_type": "concept", "source_file": "README.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_qwen3_5_4b", "label": "qwen3.5:4b Local Model", "file_type": "concept", "source_file": "README.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_local_model_fallback", "label": "Local Model Fallback", "file_type": "rationale", "source_file": "README.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the cloud fails during a task, CLIVE finishes it locally; model switches apply from the next request with no restart."}, {"id": "readme_terminal_sandbox", "label": "Terminal Sandbox (bubblewrap)", "file_type": "rationale", "source_file": "README.md", "source_location": "L141", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sandbox built from App Access switches: read-only system, no session bus/keyring/display sockets, no network unless allowed, credentials and switched-off app folders hidden. Run as administrator cannot be sandboxed, so it is handed to a visible Terminal window and CLIVE never sees the password or output."}, {"id": "readme_git_integration", "label": "Git Integration", "file_type": "concept", "source_file": "README.md", "source_location": "L155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commands run as argument lists with hooks, fsmonitor, external diff and textconv disabled; read/commit run inside the Terminal sandbox, but pull/push need network and keys so run outside it."}, {"id": "readme_email_integration", "label": "Email Integration", "file_type": "concept", "source_file": "README.md", "source_location": "L136", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_gnome_online_accounts", "label": "GNOME Online Accounts", "file_type": "concept", "source_file": "README.md", "source_location": "L137", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_gnome_keyring", "label": "GNOME Keyring / libsecret", "file_type": "concept", "source_file": "README.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_calendar_integration", "label": "Calendar Integration", "file_type": "concept", "source_file": "README.md", "source_location": "L128", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_evolution_data_server", "label": "Evolution Data Server", "file_type": "concept", "source_file": "README.md", "source_location": "L404", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_thunderbird_calendar_cache", "label": "Thunderbird Calendar Cache", "file_type": "concept", "source_file": "README.md", "source_location": "L417", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_at_spi", "label": "AT-SPI Accessibility", "file_type": "concept", "source_file": "README.md", "source_location": "L134", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Screenshots are cropped to the app's own window so other windows never reach the model; authentication and lock-screen surfaces are never available."}, {"id": "readme_mpris", "label": "MPRIS Media Control", "file_type": "concept", "source_file": "README.md", "source_location": "L134", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_clive_attachments", "label": "CLIVE Attachments", "file_type": "concept", "source_file": "README.md", "source_location": "L165", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User-attached files bypass App Access switches because the user handed them over; limited to 8 files, 25 MB each, not from system folders."}, {"id": "readme_desktop_keyboard_grab", "label": "Desktop Keyboard Grab", "file_type": "rationale", "source_file": "README.md", "source_location": "L191", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GNOME only delivers the keyboard to the desktop under an explicit grab, so the CLIVE card takes one when its text box is clicked and releases it on Esc or click elsewhere."}, {"id": "readme_clive_settings", "label": "CLIVE Settings", "file_type": "concept", "source_file": "README.md", "source_location": "L202", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_agent_checkpoints", "label": "Agent Checkpoints", "file_type": "concept", "source_file": "README.md", "source_location": "L220", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_clive_json", "label": "clive.json / clive-access.json / clive-mail.json", "file_type": "concept", "source_file": "README.md", "source_location": "L222", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_customize", "label": "Customize Tab", "file_type": "concept", "source_file": "README.md", "source_location": "L238", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Changes apply live with a Revert/Keep bar; each extension feature is isolated so one that fails is switched off until next login while the rest keep working; nothing runs on the lock screen."}, {"id": "readme_desktop_json", "label": "desktop.json", "file_type": "concept", "source_file": "README.md", "source_location": "L246", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_config_json", "label": "config.json", "file_type": "concept", "source_file": "README.md", "source_location": "L510", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_state_json", "label": "Widget State JSON", "file_type": "concept", "source_file": "README.md", "source_location": "L515", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_profiles_and_presets", "label": "Profiles and Presets", "file_type": "rationale", "source_file": "README.md", "source_location": "L252", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A preset sets only look and feel and resets those settings to neutral first, so switching presets is deterministic; input, clock, lock screen, shortcuts and rules are never touched. Preview reverts after 20 seconds unless kept."}, {"id": "readme_dfprofile_format", "label": ".dfprofile Profile Export", "file_type": "concept", "source_file": "README.md", "source_location": "L268", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Imports validate every value: numbers clamped, unknown settings dropped, foreign picture paths flagged, dock and top bar never on the same edge."}, {"id": "readme_window_rules", "label": "Window Rules", "file_type": "concept", "source_file": "README.md", "source_location": "L322", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tiling_and_snapping", "label": "Tiling & Snapping", "file_type": "concept", "source_file": "README.md", "source_location": "L288", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_top_bar", "label": "Top Bar", "file_type": "concept", "source_file": "README.md", "source_location": "L355", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hiding bars overlay content so revealing never resizes maximized windows; a hidden bar moves fully off its monitor; drags are ignored until dropped and bursts decided once to avoid flicker; reveal over fullscreen is off by default."}, {"id": "readme_dash_to_dock", "label": "Dash to Dock", "file_type": "concept", "source_file": "README.md", "source_location": "L301", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ding", "label": "Desktop Icons NG (DING)", "file_type": "concept", "source_file": "README.md", "source_location": "L334", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DING is a separate GTK window that cannot sample the live wallpaper, so glass backplates are faked with tint, gradients, rim and shadow; rules are stored as a marked reversible import in the GTK 4 user stylesheet."}, {"id": "readme_folder_colors", "label": "Folder Colors", "file_type": "concept", "source_file": "README.md", "source_location": "L385", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_desktop_widgets", "label": "Desktop Widgets", "file_type": "concept", "source_file": "README.md", "source_location": "L411", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cards are desktop-only and accept input only while uncovered, dropping behind any overlapping window; they stay inside the work area and snap to an 8-pixel grid."}, {"id": "readme_news_card", "label": "News Card", "file_type": "concept", "source_file": "README.md", "source_location": "L442", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_markets_card", "label": "Markets Card", "file_type": "concept", "source_file": "README.md", "source_location": "L489", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_weather_card", "label": "Weather Card", "file_type": "concept", "source_file": "README.md", "source_location": "L472", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_system_card", "label": "System Card", "file_type": "concept", "source_file": "README.md", "source_location": "L478", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_desktop_forged_daemon", "label": "desktop-forged Daemon", "file_type": "concept", "source_file": "README.md", "source_location": "L514", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_gnome_shell_extension", "label": "GNOME Shell Extension", "file_type": "concept", "source_file": "README.md", "source_location": "L519", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_providers", "label": "Data Providers", "file_type": "rationale", "source_file": "README.md", "source_location": "L523", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Providers do all external and system data access in the background service and write JSON state, so network work never blocks GNOME Shell."}, {"id": "readme_open_meteo", "label": "Open-Meteo", "file_type": "concept", "source_file": "README.md", "source_location": "L541", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_yahoo_chart_endpoint", "label": "Yahoo Chart Endpoint", "file_type": "concept", "source_file": "README.md", "source_location": "L542", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unofficial and may change, so it is isolated behind providers/base.py to be replaceable without changing widgets."}, {"id": "readme_shell_smoke_test", "label": "Shell Smoke Test", "file_type": "concept", "source_file": "README.md", "source_location": "L563", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_desktop_forge", "target": "readme_clive_assistant", "relation